# Copy to backend/.env and fill in. Never commit backend/.env.

# Claude API key from console.anthropic.com (claim extraction and source evaluation)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Serper API key from serper.dev (Google search results for each claim)
SERPER_API_KEY=your-serper-key-here

# Deploy only: comma-separated frontend origins allowed by CORS, no trailing slash (the Vercel URL).
# Leave empty for local development.
FRONTEND_ORIGINS=
