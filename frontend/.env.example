# Copy to frontend/.env.production (or set in the Vercel project settings). Names only, no secrets.

# Public URL of the deployed backend, no trailing slash. Without it the app calls http://127.0.0.1:8000.
VITE_API_URL=https://your-backend.example.com

# Fixture mode (no API calls). Must be false or unset in production.
VITE_USE_FIXTURES=false
